<Window x:Class="BDWpfApp1Empregado.View.DeptInterface"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BDWpfApp1Empregado.View"
        mc:Ignorable="d"
        Title="DeptInterface" Height="450" Width="450">
    <Grid>
        <Label Content="Dados do Departamento" HorizontalAlignment="Left" Margin="21,23,0,0" VerticalAlignment="Top" FontSize="18" FontWeight="Bold"/>
        <Label Content="ID" HorizontalAlignment="Left" Margin="21,62,0,0" VerticalAlignment="Top"/>
        <Label Content="Nome" HorizontalAlignment="Left" Margin="22,87,0,0" VerticalAlignment="Top"/>
        <Label Content="Email" HorizontalAlignment="Left" Margin="21,111,0,0" VerticalAlignment="Top"/>

        <TextBox x:Name="TextBoxID" HorizontalAlignment="Left" Margin="85,66,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="213"/>
        <TextBox x:Name="TextBoxNome" HorizontalAlignment="Left" Margin="85,91,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="213"/>
        <TextBox x:Name="TextBoxEmail" HorizontalAlignment="Left" Margin="85,117,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="213"/>

        <Border BorderBrush="Black" BorderThickness="1" CornerRadius="5" Padding="5"
    Margin="0,66,10,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="109">
            <StackPanel>
                <Button x:Name="ButtonPesquisar" Content="Pesquisar" Margin="0,0,0,4" Click="ButtonPesquisar_Click"/>
                <Button x:Name="ButtonSalvar" Content="Salvar" Margin="0,0,0,4" Click="ButtonSalvar_Click"/>
                <Button x:Name="ButtonTrocar" Content="Trocar" Click="ButtonTrocar_Click"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="DataGridDeptList" Margin="0,225,0,0" ColumnWidth="*" CanUserAddRows="False"/>
        <Label x:Name="LabelStatus" Content="Status" HorizontalAlignment="Left" Margin="334,3,0,0" VerticalAlignment="Top" Width="96"/>
    </Grid>
</Window>
